#!/usr/bin/env sh
# Fast checks that need only PHP: syntax and loading without WooCommerce.
# The PHPUnit suite needs WordPress and WooCommerce; see bin/install-test-env.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
find "$root" -type f -name '*.php' -not -path '*/.git/*' -not -path '*/vendor/*' -print0 | xargs -0 -n1 php -l >/dev/null
php "$root/tests/bootstrap-without-woocommerce.php"
